{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "note-tice!",
  "version": "0.1.0",
  "identifier": "app.notetice.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "note-tice!",
        "url": "/",
        "width": 1100,
        "height": 750,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 18,
          "y": 18
        },
        "minWidth": 640,
        "minHeight": 420,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: asset: ntc: http://ntc.localhost; media-src 'self' blob: ntc: http://ntc.localhost; connect-src ipc: http://ipc.localhost ntc: http://ntc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Lightweight, local-first notes",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
