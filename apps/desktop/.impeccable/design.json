      },
      {
        "name": "The Ink Stays In The Shell Rule",
        "body": "The ink surface is reserved for the sidebar and the transient toast. Content panes are always stock.",
        "section": "colors"
      },
      {
        "name": "The Tabular Time Rule",
        "body": "Dates and counts always use tabular numerals so columns of times do not jitter.",
